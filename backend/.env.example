# Server Configuration
PORT=3001

# API Keys
CONTEXT_DEV_API_KEY=your_context_dev_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Selection
LLM_PROVIDER=gemini

# Mocks (set to true to run offline without spending credits/money)
MOCK_CONTEXT=true
MOCK_LLM=true

# Chron watch scheduling (default: every 6 hours)
WATCH_CRON=0 */6 * * *
